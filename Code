long palindex_tbl[16] = {
    0,              /* 0  - Black */
    _BLUE,          /* 1  - Blue */
    _GREEN,         /* 2  - Green */
    _CYAN,          /* 3  - Cyan */
    _RED,           /* 4  - Red */
    _MAGENTA,       /* 5  - Magenta */
    _YELLOW,        /* 6  - Yellow */
    _WHITE,         /* 7  - White */
    _GRAY,          /* 8  - Gray */
