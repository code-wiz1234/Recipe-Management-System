/*==========================================================================
 * CONSTANTS & MACROS
 *==========================================================================*/
#define FLAG_ON     1
#define FLAG_OFF    0
#define FONT_X      8           /* Character width in pixels */
#define FONT_Y      16          /* Character height in pixels */
#define MAX_RECIPES 10          /* Maximum number of recipes */
#define PARAMS_PER_RECIPE 10    /* Parameters per recipe */
#define BASE_MACRO_VAR 500      /* Starting macro variable number */
#define RETRIEVE_MACRO_VAR 600  /* Macro vars for retrieved recipe */

/* Text color escape sequence */
#define STRCOL(x)   printf("\033[3%dm", x)
/* Cursor positioning escape sequence */
#define LOCATE(y,x) printf("\033[%d;%dH", y, x)

/*==========================================================================
 * TYPE DEFINITIONS
 *==========================================================================*/
