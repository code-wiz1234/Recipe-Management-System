    {34, 27, 6, 3, " F5\0"},       /* [F5] - Unused */
    {42, 27, 6, 3, " F6\0"},       /* [F6] - Unused */
    {49, 27, 6, 3, " F7 \0"},      /* [F7] - Unused */
