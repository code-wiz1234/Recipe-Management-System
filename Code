/*==========================================================================
 * GLOBAL VARIABLES
 *==========================================================================*/
static unsigned int redraw_flag = 0;    /* Screen redraw flag */
short x1, y1, x2, y2;                   /* Rectangle coordinates */
char recipe_number[10];                 /* Current recipe number string */
int parameters[PARAMS_PER_RECIPE];      /* Recipe parameter values */

